<!-- Merge into the Capacitor Android manifest during native build. SEND_SMS/RECEIVE_SMS are runtime-dangerous. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.telephony.messaging" android:required="false" />
  <uses-feature android:name="android.hardware.telephony" android:required="false" />
  <uses-permission android:name="android.permission.SEND_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>
  <application>
    <receiver
      android:name="com.therapycare.app.SmsAlarmReceiver"
      android:exported="true">
      <intent-filter android:priority="0">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.therapycare.app.SEND_SMS" />
      </intent-filter>
    </receiver>
    <!-- Confirms the WhatsApp Send action for one-click batch automation (free WhatsApp app, no paid API). -->
    <service
      android:name="com.therapycare.app.WhatsAppAutomationService"
      android:exported="false"
      android:label="Therapy Care WhatsApp automation"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/whatsapp_automation_service" />
    </service>
  </application>
</manifest>
